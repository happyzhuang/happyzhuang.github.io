---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { models, checkedAt, money, tokens, comparePath } from "../../data/models";
export function getStaticPaths() { return models.map(model => ({ params:{id:model.id},props:{model} })); }
const {model} = Astro.props;
---
<MainGridLayout title={`${model.name}：价格、规格与选型`} description={model.summary}><div class="discovery-page model-detail" data-pagefind-body><a class="platform-breadcrumb" href="/models/">← 模型资料库</a><header class="detail-header"><span class={`provider-mark ${model.tone}`}>{model.mark}</span><div><span class="eyebrow">{model.provider} / MODEL PROFILE</span><h1 data-pagefind-meta="title">{model.name}</h1><p>{model.summary}</p></div></header><div class="detail-actions"><a class="platform-button" href={comparePath([model.id,models.find(m => m.id !== model.id)!.id])}>加入模型对比 →</a><a class="platform-button secondary" href={model.tryUrl} target="_blank" rel="noreferrer">前往官方平台 ↗</a><a href="/pricing/">计算调用成本 →</a></div><div class="detail-stats"><div><span>输入 / 1M Tokens</span><strong>{money(model.input)}</strong></div><div><span>输出 / 1M Tokens</span><strong>{money(model.output)}</strong></div><div><span>{model.contextKind === "input" ? "输入上限" : "共享上下文"}</span><strong>{tokens(model.context)}</strong></div><div><span>最大输出</span><strong>{tokens(model.maxOutput)}</strong></div></div><section class="detail-body"><article><h2>选择它之前</h2><p>{model.caveat}</p><h2>已核验的接口能力</h2><ul><li>文本输入与文本输出</li><li>工具调用：{model.tools ? "支持" : "未核验"}</li><li>视觉输入：{model.vision ? "支持" : "本条目未收录视觉能力"}</li><li>联网检索工具：{model.search ? "文档已确认，工具费用另计" : "本次未核验，请查看官方文档"}</li></ul><h2>如何验证是否适合你</h2><p>选取一组有标准答案或验收要求的真实任务，使用相同输入，记录任务完成情况、失败原因、实际 Token 数与耗时。本站尚未对该模型独立实测，不提供未经验证的质量分数。</p><a href="/posts/2026_07/evaluation-dataset/">学习如何建立评测集 →</a></article><aside><h2>价格与来源</h2><p>{model.pricingNote}</p><p>缓存命中：{money(model.cached)} / 1M 输入 Token。</p><p>核验日期：<time datetime={checkedAt}>{checkedAt}</time></p><a href={model.source} target="_blank" rel="noreferrer">官方价格文档 ↗</a><a href={model.specs} target="_blank" rel="noreferrer">官方规格文档 ↗</a><a href="/benchmarks/">本站数据口径 →</a></aside></section></div></MainGridLayout>
