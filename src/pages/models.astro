---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import PageIntro from "@components/discovery/PageIntro.astro";
import ModelExplorer from "@components/discovery/ModelExplorer.svelte";
---
<MainGridLayout title="AI 模型资料库" description="查找具体 AI 模型版本，比较 API 价格、上下文与能力，加入模型对比。"><div class="discovery-page"><PageIntro eyebrow="MODEL DIRECTORY" title="认识模型，再做选择。" description="从 GPT、Claude、Gemini 与 DeepSeek 开始。查看官方规格、价格条件与接入入口。"/><ModelExplorer client:load /></div></MainGridLayout>
