---
import type { CollectionEntry } from "astro:content";
import { getPostUrlBySlug } from "@utils/url-utils";
import ModelExplorer from "./discovery/ModelExplorer.svelte";
import { models, checkedAt, money } from "../data/models";
interface Props { latestPosts: CollectionEntry<"posts">[]; }
const { latestPosts } = Astro.props;
const pairs = [
 {name:"GPT × Claude",detail:"复杂任务，如何权衡成本？",ids:["gpt-6-astra","claude-sonnet-5"],marks:["O","A"],href:"/compare/gpt-vs-claude/"},
 {name:"Gemini × DeepSeek",detail:"多模态输入，还是文本调用？",ids:["gemini-3-8-flash","deepseek-v4-flash"],marks:["G","D"],href:"/compare/gemini-vs-deepseek/"},
 {name:"Sonnet × Haiku",detail:"同一厂商，不同预算。",ids:["claude-sonnet-5","claude-haiku-4-5"],marks:["A","A"],href:"/compare/sonnet-vs-haiku/"},
];
const budgetModels = [...models].sort((a,b)=>a.input*10+a.output*2-b.input*10-b.output*2).slice(0,3);
---
<div class="discovery-page discovery-home">
 <section class="discovery-hero"><div class="hero-platform-copy"><span class="platform-kicker"><span></span> THE RIGHT MODEL. FOR YOUR NEXT IDEA.</span><h1>Hello, LLM.<br/><span>找到适合你任务的 AI。</span></h1><p>模型越多，选择越需要依据。比较能力、价格与使用条件，<br class="desktop-break"/>让下一次调用，从一个清楚的选择开始。</p><form class="finder-launch" action="/finder/" method="get"><label class="sr-only" for="home-task">你希望 AI 完成的任务</label><span aria-hidden="true">✳</span><input id="home-task" name="q" maxlength="1000" placeholder="你希望 AI 做什么？例如，分析 100 份 PDF" required/><button type="submit">帮我选模型 <span aria-hidden="true">→</span></button></form><div class="hero-suggestions"><span>试试看</span><a href="/finder/?q=帮我编写代码">写代码 ↗</a><a href="/finder/?q=分析PDF文档">分析文档 ↗</a><a href="/finder/?q=构建Agent工具调用">构建 Agent ↗</a></div></div><aside class="hero-cost-preview"><div class="preview-heading"><span>一次选择，算清差异。</span><a href="/pricing/" aria-label="打开费用计算器">↗</a></div><span class="preview-label">10M 输入 + 2M 输出 Token</span><div class="preview-cost-list">{budgetModels.map(m=><div><span class={`provider-mark ${m.tone}`}>{m.mark}</span><span>{m.name}</span><strong>{money(m.input*10+m.output*2)}</strong></div>)}</div><p>未缓存 / Standard；DeepSeek 按高峰价。<br/>Token 费用示例，不代表质量排名。</p><a class="preview-link" href="/pricing/">换成我的调用规模 →</a></aside></section>
 <div class="platform-trustbar"><div><strong>{models.length}</strong><span>已收录模型</span></div><div><strong>{new Set(models.map(m=>m.provider)).size}</strong><span>模型厂商</span></div><div><span class="status-dot"></span><span>官方资料核验 · {checkedAt}</span></div><a href="/benchmarks/">公开来源与比较方法 ↗</a></div>
 <div class="discovery-workspace"><section class="home-models"><div class="section-heading"><div><span class="eyebrow">EXPLORE MODELS</span><h2>从任务出发，缩小选择范围。</h2></div><a href="/rankings/">查看榜单 ↗</a></div><ModelExplorer compact client:load /></section><aside class="discovery-rail"><section class="rail-card"><span class="eyebrow">SIDE BY SIDE</span><h2>从一组对比开始</h2>{pairs.map(p=><a class="pair-card" href={p.href}><span class="pair-marks"><b>{p.marks[0]}</b><i>vs</i><b>{p.marks[1]}</b></span><strong>{p.name} <span>↗</span></strong><small>{p.detail}</small></a>)}</section><a class="rail-finder" href="/finder/"><span class="eyebrow">MODEL FINDER</span><h3>还不知道<br/>该选哪一个？</h3><p>告诉我们任务与预算，<br/>先拿到一份候选清单。</p><strong>开始选型 →</strong></a><a class="rail-method" href="/benchmarks/"><span>数据透明，选择有据。</span><p>查看每项数据的来源、适用条件和核验时间。</p><strong>了解数据口径 ↗</strong></a></aside></div>
 <section class="platform-next"><a href="/pricing/"><span>01 / ESTIMATE</span><h3>每月会花多少钱？ ↗</h3><p>调整 Token、请求数和缓存比例，比较不同模型的月度成本。</p></a><a href="/benchmarks/"><span>02 / EVALUATE</span><h3>怎么看懂评测？ ↗</h3><p>分清质量、速度与成本，找到适合任务的评测依据。</p></a><a href="/learn/"><span>03 / BUILD</span><h3>选好模型，开始构建。 ↗</h3><p>从第一次 API 调用到 RAG 与 Agent，跟随中文教程动手实践。</p></a></section>
 <section class="platform-reading"><div class="section-heading"><div><span class="eyebrow">LEARN & BUILD</span><h2>把选择，变成实践。</h2></div><a href="/archive/">全部文章 ↗</a></div><div class="platform-articles">{latestPosts.map(p=><a href={getPostUrlBySlug(p.slug)}><span>{p.data.category}</span><h3>{p.data.title}</h3><p>{p.data.description}</p><small>阅读文章 →</small></a>)}</div></section>
 <nav class="platform-resources" aria-label="更多资源"><span>LLMHello</span><a href="/models/">模型资料库</a><a href="/learn/">中文教程</a><a href="/map/">学习路线</a><a href="/prompts/">Prompt 配方</a><a href="/labs/">实验室</a><a href="/about/">关于</a><a href="/rss.xml">RSS ↗</a></nav>
</div>
